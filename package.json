{
  "name": "@tupynambalucas/knowledge-lab",
  "version": "1.0.0",
  "private": true,
  "description": "Root monorepo workspace for the knowledge-lab ecosystem.",
  "author": "Tupynambá Lucas Varela Rodrigues <tupynambalucas.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tupynambalucas/Knowledge-Lab.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0"
    }
  },
  "scripts": {
    "// Knowledge Base Context": "---------------------------------------------",
    "kb:typecheck": "turbo run typecheck --filter=\"@knowledge-lab/*\"",
    "kb:lint": "turbo run lint --filter=\"@knowledge-lab/*\"",
    "kb:dev": "pnpm --filter @knowledge-lab/app-main start",
    "kb:build": "turbo run build --filter=@knowledge-lab/app-main",
    "kb:preview": "pnpm kb:build && pnpm --filter @knowledge-lab/app-main serve",
    "kb:clear": "pnpm --filter @knowledge-lab/app-main clear",
    "kb:down": "pnpm dlx kill-port 3002",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@docusaurus/eslint-plugin": "catalog:tooling-stack",
    "@eslint-react/eslint-plugin": "catalog:web-stack",
    "@eslint/js": "catalog:tooling-stack",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:tooling-stack",
    "eslint": "catalog:tooling-stack",
    "eslint-config-prettier": "catalog:tooling-stack",
    "eslint-import-resolver-typescript": "catalog:tooling-stack",
    "eslint-plugin-import-x": "catalog:tooling-stack",
    "eslint-plugin-mdx": "catalog:tooling-stack",
    "eslint-plugin-prettier": "catalog:tooling-stack",
    "eslint-plugin-react-refresh": "catalog:web-stack",
    "eslint-plugin-react-hooks": "catalog:tooling-stack",
    "globals": "catalog:tooling-stack",
    "jiti": "catalog:tooling-stack",
    "kill-port": "catalog:",
    "prettier": "catalog:tooling-stack",
    "rimraf": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:tooling-stack"
  }
}
